#include <stdio.h>

#define MAX 3

int stack[MAX], top = -1;

void push();
void pop();
void peek();
void update();
void display();

void main()
{
    int op;

    do
    {
        printf("\n1. Push");
        printf("\n2. Pop");
        printf("\n3. Peek");
        printf("\n4. Update");
        printf("\n5. Display");
        printf("\n6. Exit");

        printf("\nEnter your choice: ");
        scanf("%d", &op);

        switch (op)
        {
            case 1:
                push();
                break;

            case 2:
                pop();
                break;

            case 3:
                peek();
                break;

            case 4:
                update();
                break;

            case 5:
                display();
                break;

            case 6:
                printf("\nExiting...");
                break;

            default:
                printf("\nInvalid Choice!");
        }

    } while (op != 6);
}

void push()
{
    int value;

    printf("\nEnter value to be added: ");
    scanf("%d", &value);

    if (top == MAX - 1)
    {
        printf("\nStack Overflow!");
    }
    else
    {
        top++;
        stack[top] = value;
    }
}

void pop()
{
    int val;

    if (top == -1)
    {
        printf("\nStack Underflow!");
    }
    else
    {
        val = stack[top];
        top--;

        printf("\nDeleted Value: %d", val);
    }
}

void peek()
{
    if (top == -1)
    {
        printf("\nStack is Empty!");
    }
    else
    {
        printf("\nTop Element: %d", stack[top]);
    }
}

void update()
{
    int i, x;

    printf("\nEnter index from top (1 = Top): ");
    scanf("%d", &i);

    printf("Enter new value: ");
    scanf("%d", &x);

    if (i <= 0 || i > top + 1)
    {
        printf("\nInvalid Index!");
    }
    else
    {
        stack[top - i + 1] = x;
        printf("\nValue Updated Successfully!");
    }
}

void display()
{
    int i;

    if (top == -1)
    {
        printf("\nStack is Empty!");
    }
    else
    {
        printf("\nStack Elements:");

        for (i = top; i >= 0; i--)
        {
            printf("\n%d", stack[i]);
        }
    }
}